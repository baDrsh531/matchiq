# Example environment variables for MatchIQ
# Copy this file to `.env` and fill the values locally. NEVER commit real keys.

# API-Football: sign up at https://www.api-football.com/ to obtain your key
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- LLM backend (interchangeable) ---
# LLM_PROVIDER=gemini (default) or openai
LLM_PROVIDER=gemini

# Gemini (LLM): create a key via Google AI Studio / Vertex AI
GEMINI_API_KEY=

# OpenAI-compatible backend (vLLM, llama.cpp, Ollama, LM Studio, or the OpenAI API).
# Only used when LLM_PROVIDER=openai. Point OPENAI_BASE_URL at the server's /v1.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Disable the "thinking" phase of reasoning models (Qwen3, etc.) so they return
# a non-empty answer. Ignored by servers that do not support it.
LLM_NO_THINK=true

# Optional: local DB path (default used by the app if omitted)
DATABASE_URL=sqlite:///data/matchiq.db
